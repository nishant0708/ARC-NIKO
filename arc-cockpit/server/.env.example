# Copy to server/.env and fill in. Never commit .env.
# file   = PILOT export files in data/ (default)
# airgen = live Airgen ERP over MCP
DATA_SOURCE=airgen
AGENTIC_ERP_URL=https://dynamic-cyan-raccoon.erp.airgen.ai/mcp
AGENTIC_ERP_TOKEN=paste-a-read-only-api-key-here
# Minutes between refreshes (0 = load once at start-up)
ERP_REFRESH_MINUTES=15
# Optional: fix the as-of date and fiscal year instead of using today
# ERP_AS_OF=2026-09-22
# ERP_FISCAL_YEAR=2026
PORT=4000
# Address to listen on. Keep 127.0.0.1 on a server: nginx is the only way in.
HOST=127.0.0.1
