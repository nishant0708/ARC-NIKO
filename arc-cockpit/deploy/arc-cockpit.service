[Unit]
Description=ARC cockpit GraphQL server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@COCKPIT_DIR@/server
Environment=NODE_ENV=production
Environment=HOME=/tmp
ExecStart=@COCKPIT_DIR@/node_modules/.bin/tsx src/index.ts
Restart=on-failure
RestartSec=10
# Hardening: the server only reads its own files and talks to the ERP
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
